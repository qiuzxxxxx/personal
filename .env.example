# 缺页中断 环境变量示例
#
# 按实际环境设置。所有密钥都只放在服务端，不进版本库。
# 生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --------------------------------------------------------------------------- #
# 运行环境
# --------------------------------------------------------------------------- #
# development | production。生产环境会强制要求稳定密钥并启用 HTTPS 相关设置。
DJANGO_ENV=production
DJANGO_DEBUG=0

# 生产环境必填。缺失时服务拒绝启动（随机密钥会让每次重启都掉登录态）。
DJANGO_SECRET_KEY=

# 允许访问的域名，逗号分隔。填实际域名，不要用 *。
DJANGO_ALLOWED_HOSTS=workbench.example.com

# 反向代理层数。前面有可信代理时保持 1。
NEXUS_TRUSTED_PROXY_HOPS=1

# 对外访问地址。手机扫码的二维码依赖它。
PUBLIC_BASE_URL=https://workbench.example.com

# 前后端同源部署时通常留空；分离部署时填前端来源。
DJANGO_CORS_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# 反向代理应传入 X-Forwarded-Proto=https；后端仍会校验并把 HTTP 请求跳转到 HTTPS。
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
# 仅当该域名下全部子域都支持 HTTPS 时才打开；提交 HSTS preload 前须另行确认。
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0

# --------------------------------------------------------------------------- #
# 主密钥（加密保存用户模型 Key）
# --------------------------------------------------------------------------- #
# 生产环境必填。更换该值后，历史上加密的模型 Key 将无法解密。
NEXUS_MASTER_KEY=

# --------------------------------------------------------------------------- #
# 数据库
# --------------------------------------------------------------------------- #
# 本地开发可用 sqlite3；生产环境必须使用 postgres。
DATABASE_ENGINE=postgres
POSTGRES_DB=zixxx
POSTGRES_USER=zixxx
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# 连接存活时间上限（秒）。max_connections=30 时不要调大。
POSTGRES_CONN_MAX_AGE=60

# --------------------------------------------------------------------------- #
# Redis（限速、频道广播、匿名上传预算）。本地不配置即可（单进程内生效）。
# --------------------------------------------------------------------------- #
# 未配置时限速与广播只在单个进程内有效；多进程部署前必须配置。
REDIS_URL=
# 缓存使用独立的 DB，频道消息使用另一个，避免互相挤占内存。
REDIS_CACHE_DB=1
REDIS_CHANNEL_URL=
REDIS_CACHE_TIMEOUT=300
REDIS_KEY_PREFIX=zixxx

# --------------------------------------------------------------------------- #
# 模型接口
# --------------------------------------------------------------------------- #
# 使用 deepseek 或 custom 时的内置 Key（也可用前端自带 Key）。
NEXUS_BUILTIN_LLM_API_KEY=

# 允许 HTTP 访问的本机/内网模型接口来源，必须精确配置 origin（含协议和端口），逗号分隔。
# 公网模型接口必须使用 HTTPS；内网 HTTP 示例：http://192.168.1.20:8000
NEXUS_LLM_PRIVATE_ORIGINS=

# --------------------------------------------------------------------------- #
# 扫码上传
# --------------------------------------------------------------------------- #
UPLOAD_SESSION_TTL_SECONDS=600
UPLOAD_SESSION_MAX_FILES=20
UPLOAD_SESSION_MAX_BYTES=1073741824
UPLOAD_SESSION_MAX_FILE_BYTES=1073741824
UPLOAD_SESSION_MAX_ACTIVE=3
UPLOAD_RECEIPT_LEASE_SECONDS=1200

# --------------------------------------------------------------------------- #
# 免密中转站预算（防止匿名上传占满磁盘）
# --------------------------------------------------------------------------- #
# 单个客户端地址在统计窗口内允许的免密上传总量（字节）。0 表示不限制。
TRANSFER_ANONYMOUS_TOTAL_BYTES=2147483648
TRANSFER_ANONYMOUS_WINDOW_SECONDS=3600
TRANSFER_ANONYMOUS_MAX_FILES_PER_WINDOW=60
